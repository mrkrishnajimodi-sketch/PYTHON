<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Anushka ❤️ Love.exe</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Dancing+Script:wght@600;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: #0a0a0a;
      color: #fff;
      overflow: hidden;
      height: 100dvh;
      width: 100vw;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    /* Floating hearts background */
    .hearts-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }
    .heart-float {
      position: absolute;
      font-size: 18px;
      opacity: 0.25;
      animation: floatUp 12s linear infinite;
      color: #ff6b9d;
    }
    @keyframes floatUp {
      0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
      10% { opacity: 0.4; }
      90% { opacity: 0.3; }
      100% { transform: translateY(-20vh) rotate(360deg); opacity: 0; }
    }

    .screen {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 24px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.6s ease;
      z-index: 10;
      text-align: center;
    }
    .screen.active {
      opacity: 1;
      pointer-events: auto;
    }

    /* ===== MATRIX / COUNTDOWN ===== */
    #screen-matrix {
      background: #000;
    }
    .matrix-canvas {
      position: absolute;
      inset: 0;
      z-index: 1;
    }
    .countdown-num {
      font-size: clamp(80px, 25vw, 160px);
      font-weight: 700;
      color: #00ff9d;
      text-shadow: 0 0 30px #00ff9d, 0 0 60px #00ff9d;
      z-index: 5;
      position: relative;
      animation: pulse 0.8s ease;
    }
    @keyframes pulse {
      0% { transform: scale(0.5); opacity: 0; }
      50% { transform: scale(1.15); }
      100% { transform: scale(1); opacity: 1; }
    }
    .matrix-text {
      position: absolute;
      bottom: 80px;
      font-size: 14px;
      color: #00ff9d;
      opacity: 0.7;
      z-index: 5;
      letter-spacing: 2px;
    }

    /* ===== CHALLENGE ACCEPTED ===== */
    #screen-challenge {
      background: linear-gradient(180deg, #1a0a14 0%, #2d0b1f 100%);
    }
    .challenge-title {
      font-size: clamp(28px, 8vw, 42px);
      font-weight: 700;
      margin-bottom: 12px;
      background: linear-gradient(90deg, #ff6b9d, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .emoji-big {
      font-size: 48px;
      margin: 16px 0;
    }

    /* ===== LOADING SCREENS ===== */
    .loading-box {
      width: min(340px, 90vw);
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 24px;
      padding: 36px 28px;
      backdrop-filter: blur(12px);
    }
    .loading-title {
      font-size: 20px;
      font-weight: 500;
      margin-bottom: 28px;
      color: #fce7f3;
    }
    .progress-track {
      height: 8px;
      background: rgba(255,255,255,0.1);
      border-radius: 99px;
      overflow: hidden;
      margin-bottom: 12px;
    }
    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #ff6b9d, #c084fc, #60a5fa);
      border-radius: 99px;
      transition: width 0.15s linear;
    }
    .progress-pct {
      font-size: 14px;
      color: #fda4af;
      font-weight: 500;
    }

    /* ===== FOUND RESULT ===== */
    .found-title {
      font-size: 26px;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .found-btn {
      margin-top: 28px;
      background: linear-gradient(135deg, #ff6b9d, #ec4899);
      border: none;
      color: white;
      padding: 14px 36px;
      border-radius: 99px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 8px 24px rgba(236,72,153,0.4);
      transition: transform 0.2s;
    }
    .found-btn:active { transform: scale(0.96); }

    /* ===== LETTER ===== */
    .letter-envelope {
      width: 220px;
      height: 150px;
      position: relative;
      cursor: pointer;
      transition: transform 0.4s;
    }
    .letter-envelope:hover { transform: scale(1.05); }
    .envelope-body {
      width: 100%;
      height: 100%;
      background: linear-gradient(145deg, #fda4af, #fb7185);
      border-radius: 8px 8px 12px 12px;
      position: relative;
      box-shadow: 0 12px 40px rgba(251,113,133,0.4);
    }
    .envelope-flap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 70px;
      background: linear-gradient(145deg, #fb7185, #f43f5e);
      clip-path: polygon(0 0, 50% 70%, 100% 0);
      transform-origin: top;
      transition: transform 0.6s ease;
      z-index: 2;
    }
    .envelope-flap.open {
      transform: rotateX(180deg);
    }
    .envelope-heart {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -30%);
      font-size: 32px;
      z-index: 3;
    }
    .letter-label {
      margin-top: 28px;
      font-size: 15px;
      color: #fda4af;
      opacity: 0.9;
    }

    /* ===== MESSAGE CARDS ===== */
    .msg-card {
      width: min(360px, 92vw);
      background: rgba(255,255,255,0.95);
      color: #1f2937;
      border-radius: 24px;
      padding: 36px 28px 28px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.3);
      position: relative;
    }
    .msg-for-you {
      font-family: 'Dancing Script', cursive;
      font-size: 28px;
      color: #ec4899;
      margin-bottom: 20px;
    }
    .msg-text {
      font-size: 17px;
      line-height: 1.65;
      color: #374151;
      margin-bottom: 28px;
      min-height: 80px;
    }
    .msg-btn {
      background: linear-gradient(135deg, #ec4899, #db2777);
      border: none;
      color: white;
      padding: 13px 40px;
      border-radius: 99px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      width: 100%;
      max-width: 200px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .msg-btn:active { transform: scale(0.97); }

    /* ===== CHOICE BUTTONS ===== */
    .choice-card {
      width: min(340px, 90vw);
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 28px;
      padding: 40px 24px;
      backdrop-filter: blur(16px);
    }
    .choice-icon {
      font-size: 48px;
      margin-bottom: 16px;
    }
    .choice-title {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 28px;
    }
    .choice-btns {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn-yes, .btn-no {
      padding: 14px 28px;
      border-radius: 99px;
      font-size: 16px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.25s;
      min-width: 120px;
    }
    .btn-yes {
      background: linear-gradient(135deg, #ec4899, #db2777);
      color: white;
      box-shadow: 0 6px 20px rgba(236,72,153,0.45);
    }
    .btn-yes:hover { transform: scale(1.05); }
    .btn-no {
      background: rgba(255,255,255,0.12);
      color: #fce7f3;
      border: 1px solid rgba(255,255,255,0.2);
      position: relative;
    }

    /* ===== PLAY LOVE ===== */
    .vinyl {
      width: 160px;
      height: 160px;
      border-radius: 50%;
      background: radial-gradient(circle at center, #1f2937 0%, #1f2937 28%, #ec4899 29%, #ec4899 32%, #1f2937 33%, #1f2937 48%, #ec4899 49%, #ec4899 52%, #1f2937 53%);
      box-shadow: 0 0 40px rgba(236,72,153,0.5);
      margin-bottom: 20px;
      animation: spin 4s linear infinite;
      position: relative;
    }
    .vinyl::after {
      content: '';
      position: absolute;
      inset: 42%;
      background: #0a0a0a;
      border-radius: 50%;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    .play-title {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .play-sub {
      font-size: 14px;
      color: #fda4af;
      margin-bottom: 24px;
    }
    .play-btn {
      background: linear-gradient(135deg, #ec4899, #db2777);
      border: none;
      color: white;
      padding: 14px 36px;
      border-radius: 99px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* ===== FINAL QUESTION ===== */
    #screen-question {
      background: linear-gradient(180deg, #1a0a14, #2d0b1f);
    }
    .q-title {
      font-size: clamp(22px, 6vw, 28px);
      font-weight: 600;
      margin-bottom: 8px;
      line-height: 1.4;
    }
    .q-heart {
      font-size: 36px;
      margin: 16px 0 28px;
    }
    .no-btn-wrapper {
      position: relative;
      height: 60px;
      width: 100%;
      max-width: 280px;
      margin-top: 16px;
    }
    #noBtn {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* ===== CELEBRATION ===== */
    #screen-yay {
      background: linear-gradient(180deg, #1a0a14, #3b0a2a);
    }
    .yay-title {
      font-size: clamp(36px, 10vw, 52px);
      font-weight: 700;
      background: linear-gradient(90deg, #ff6b9d, #c084fc, #60a5fa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 12px;
      animation: bounceIn 0.8s ease;
    }
    @keyframes bounceIn {
      0% { transform: scale(0.3); opacity: 0; }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); opacity: 1; }
    }
    .yay-text {
      font-size: 16px;
      line-height: 1.7;
      color: #fce7f3;
      max-width: 320px;
      margin-bottom: 20px;
    }
    .ring {
      font-size: 64px;
      margin: 12px 0 20px;
      animation: ringPulse 1.5s ease infinite;
    }
    @keyframes ringPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.15); }
    }
    .welcome-btn {
      background: linear-gradient(135deg, #ec4899, #db2777);
      border: none;
      color: white;
      padding: 16px 40px;
      border-radius: 99px;
      font-size: 17px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(236,72,153,0.45);
      margin-bottom: 14px;
    }
    .moments-btn {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.25);
      color: #fce7f3;
      padding: 13px 28px;
      border-radius: 99px;
      font-size: 15px;
      font-weight: 500;
      cursor: pointer;
      margin-top: 8px;
      transition: all 0.25s;
    }
    .moments-btn:active { transform: scale(0.97); background: rgba(255,255,255,0.2); }

    /* ===== TIMER ===== */
    .timer-grid {
      display: flex;
      gap: 12px;
      margin: 24px 0;
      flex-wrap: wrap;
      justify-content: center;
    }
    .timer-box {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 16px;
      padding: 14px 18px;
      min-width: 70px;
    }
    .timer-num {
      font-size: 28px;
      font-weight: 700;
      color: #fda4af;
    }
    .timer-label {
      font-size: 11px;
      color: #9ca3af;
      letter-spacing: 1px;
      margin-top: 2px;
    }
    .final-quote {
      font-family: 'Dancing Script', cursive;
      font-size: 22px;
      color: #fce7f3;
      margin-top: 20px;
      max-width: 300px;
    }

    /* ===== CUTE MOMENTS GALLERY ===== */
    #screen-moments {
      background: linear-gradient(180deg, #1a0a14, #2d0b1f);
      padding: 16px;
    }
    .gallery-header {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 12px;
      color: #fce7f3;
    }
    .gallery-sub {
      font-size: 13px;
      color: #fda4af;
      margin-bottom: 16px;
    }
    .gallery-container {
      width: 100%;
      max-width: 380px;
      position: relative;
      overflow: hidden;
      border-radius: 20px;
      background: #111;
      box-shadow: 0 12px 40px rgba(0,0,0,0.5);
      touch-action: pan-y;
    }
    .gallery-track {
      display: flex;
      transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
      will-change: transform;
    }
    .gallery-slide {
      min-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 8px;
    }
    .gallery-slide img {
      width: 100%;
      max-height: 55vh;
      object-fit: contain;
      border-radius: 16px;
      user-select: none;
      -webkit-user-drag: none;
    }
    .gallery-caption {
      margin-top: 12px;
      font-size: 14px;
      color: #fda4af;
      min-height: 20px;
    }
    .gallery-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      max-width: 380px;
      margin-top: 18px;
      gap: 12px;
    }
    .nav-btn {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      color: white;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      font-size: 22px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .nav-btn:active { transform: scale(0.92); background: rgba(255,255,255,0.2); }
    .nav-btn:disabled {
      opacity: 0.3;
      pointer-events: none;
    }
    .gallery-dots {
      display: flex;
      gap: 8px;
      justify-content: center;
      flex: 1;
    }
    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(255,255,255,0.3);
      transition: all 0.25s;
    }
    .dot.active {
      background: #ec4899;
      transform: scale(1.3);
    }
    .gallery-counter {
      font-size: 13px;
      color: #9ca3af;
      margin-top: 10px;
    }
    .back-btn {
      margin-top: 20px;
      background: linear-gradient(135deg, #ec4899, #db2777);
      border: none;
      color: white;
      padding: 12px 32px;
      border-radius: 99px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }

    /* Confetti canvas */
    #confetti {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 100;
    }

    /* Tiny Instagram credit */
    .credit {
      position: fixed;
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 12px;
      color: rgba(255,255,255,0.35);
      z-index: 50;
      pointer-events: none;
    }
  </style>
</head>
<body>
  <div class="hearts-bg" id="heartsBg"></div>
  <canvas id="confetti"></canvas>

  <!-- SCREEN 0: Matrix + Countdown -->
  <div class="screen active" id="screen-matrix">
    <canvas class="matrix-canvas" id="matrixCanvas"></canvas>
    <div class="countdown-num" id="countdownNum"></div>
    <div class="matrix-text">INITIALIZING...</div>
  </div>

  <!-- SCREEN 1: Challenge Accepted -->
  <div class="screen" id="screen-challenge">
    <div class="challenge-title">Challenge Accepted</div>
    <div class="emoji-big">💻❤️</div>
    <p style="color:#fda4af;font-size:15px;margin-top:8px;">Software Developer mode: ON</p>
  </div>

  <!-- SCREEN 2: Initializing Love.exe -->
  <div class="screen" id="screen-init">
    <div class="loading-box">
      <div class="loading-title" id="loadTitle">Initializing Love.exe...</div>
      <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
      <div class="progress-pct" id="progressPct">0%</div>
    </div>
  </div>

  <!-- SCREEN 3: Found Result -->
  <div class="screen" id="screen-found">
    <div class="found-title">Found 1 Result ❤️</div>
    <p style="color:#fda4af;margin:8px 0 0;">Searching complete</p>
    <button class="found-btn" onclick="goTo('letter')">Open Result</button>
  </div>

  <!-- SCREEN 4: Letter -->
  <div class="screen" id="screen-letter">
    <div class="letter-envelope" id="envelope" onclick="openLetter()">
      <div class="envelope-body">
        <div class="envelope-flap" id="flap"></div>
        <div class="envelope-heart">💌</div>
      </div>
    </div>
    <div class="letter-label" id="letterLabel">A LETTER ARRIVED<br><small>tap the envelope to open it</small></div>
  </div>

  <!-- SCREEN 5: Messages -->
  <div class="screen" id="screen-msg">
    <div class="msg-card">
      <div class="msg-for-you">for you</div>
      <div class="msg-text" id="msgText"></div>
      <button class="msg-btn" id="msgBtn" onclick="nextMsg()">Next</button>
    </div>
  </div>

  <!-- SCREEN 6: Coffee Date -->
  <div class="screen" id="screen-coffee">
    <div class="choice-card">
      <div class="choice-icon">☕</div>
      <div class="choice-title">Coffee Date?</div>
      <div class="choice-btns">
        <button class="btn-yes" onclick="goTo('talks')">YES</button>
        <button class="btn-yes" onclick="goTo('talks')" style="background:linear-gradient(135deg,#a78bfa,#8b5cf6)">OF COURSE</button>
      </div>
    </div>
  </div>

  <!-- SCREEN 7: Late Night Talks -->
  <div class="screen" id="screen-talks">
    <div class="choice-card">
      <div class="choice-icon">🌙</div>
      <div class="choice-title">Late Night Talks?</div>
      <div class="choice-btns">
        <button class="btn-yes" onclick="goTo('play')">100%</button>
        <button class="btn-yes" onclick="goTo('play')" style="background:linear-gradient(135deg,#a78bfa,#8b5cf6)">FOREVER</button>
      </div>
    </div>
  </div>

  <!-- SCREEN 8: Play Love -->
  <div class="screen" id="screen-play">
    <div class="vinyl"></div>
    <div class="play-title">Us ❤️</div>
    <div class="play-sub">Our Story</div>
    <button class="play-btn" onclick="goTo('feeling')">▶ Play Love</button>
  </div>

  <!-- SCREEN 9: Feeling message -->
  <div class="screen" id="screen-feeling">
    <div class="msg-card">
      <div class="msg-text" style="font-size:18px;margin-bottom:0;">
        Anushka, tum sirf meri favourite person nahi ho...<br><br>
        <strong style="color:#ec4899;">Tum meri favourite feeling ho.<br>Main tumse bahut zyada pyaar karta hoon. 💕</strong>
      </div>
      <button class="msg-btn" style="margin-top:28px;" onclick="goTo('ask')">Continue ❤️</button>
    </div>
  </div>

  <!-- SCREEN 10: Ask permission -->
  <div class="screen" id="screen-ask">
    <div class="choice-card">
      <div style="font-size:18px;color:#fda4af;margin-bottom:8px;">So...</div>
      <div class="choice-title">Ek Question Puchu?</div>
      <button class="btn-yes" onclick="goTo('question')" style="margin-top:8px;">Haan Pucho</button>
    </div>
  </div>

  <!-- SCREEN 11: The Question -->
  <div class="screen" id="screen-question">
    <div class="q-title">Anushka,<br>Kya Tum Meri<br>Girlfriend Banogi?</div>
    <div class="q-heart">💗</div>
    <button class="btn-yes" id="yesBtn" onclick="goTo('yay')" style="min-width:160px;font-size:18px;">❤️ YES</button>
    <div class="no-btn-wrapper">
      <button class="btn-no" id="noBtn" onclick="noClick()">SHAYAD NAHI 🙈</button>
    </div>
  </div>

  <!-- SCREEN 12: Yay Celebration -->
  <div class="screen" id="screen-yay">
    <div class="yay-title">Yayyyyyyyyy ❤️</div>
    <div class="yay-text">
      Officially Anushka...<br>
      Ab tum meri favourite notification ho.<br><br>
      Main tumse bahut zyada pyaar karta hoon.<br><br>
      I Promise...<br>
      Har smile ki wajah banne ki<br>puri koshish karunga.
    </div>
    <div class="ring">💍</div>
    <button class="welcome-btn" onclick="goTo('timer')">Welcome to Our Story</button>
    <button class="moments-btn" onclick="openMoments()">Wanna see our cute moments? 💕</button>
  </div>

  <!-- SCREEN 13: Timer -->
  <div class="screen" id="screen-timer">
    <div style="font-size:26px;font-weight:600;margin-bottom:4px;">Welcome to Our Story ❤️</div>
    <div style="font-size:13px;color:#fda4af;letter-spacing:2px;margin-bottom:8px;">TOGETHER SINCE</div>
    <div class="timer-grid">
      <div class="timer-box"><div class="timer-num" id="tDays">0</div><div class="timer-label">DAYS</div></div>
      <div class="timer-box"><div class="timer-num" id="tHours">0</div><div class="timer-label">HOURS</div></div>
      <div class="timer-box"><div class="timer-num" id="tMins">0</div><div class="timer-label">MINUTES</div></div>
      <div class="timer-box"><div class="timer-num" id="tSecs">0</div><div class="timer-label">SECONDS</div></div>
    </div>
    <div class="final-quote">Some Love Stories Start With One Click.</div>
    <button class="moments-btn" style="margin-top:24px;" onclick="openMoments()">Wanna see our cute moments? 💕</button>
  </div>

  <!-- SCREEN 14: Cute Moments Gallery -->
  <div class="screen" id="screen-moments">
    <div class="gallery-header">Our Cute Moments 💕</div>
    <div class="gallery-sub">Swipe left / right or use arrows</div>
    
    <div class="gallery-container" id="galleryContainer">
      <div class="gallery-track" id="galleryTrack">
        <!-- slides injected by JS -->
      </div>
    </div>

    <div class="gallery-nav">
      <button class="nav-btn" id="prevBtn" onclick="prevSlide()">‹</button>
      <div class="gallery-dots" id="galleryDots"></div>
      <button class="nav-btn" id="nextBtn" onclick="nextSlide()">›</button>
    </div>
    <div class="gallery-counter" id="galleryCounter">1 / 5</div>
    <button class="back-btn" onclick="goTo('timer')">Back to Our Story ❤️</button>
  </div>

  <div class="credit">Made with ❤️ for Anushka</div>

  <script>
    // ========== FLOATING HEARTS ==========
    function createHearts() {
      const bg = document.getElementById('heartsBg');
      for (let i = 0; i < 18; i++) {
        const h = document.createElement('div');
        h.className = 'heart-float';
        h.textContent = ['❤️','💕','💗','💖','🩷'][Math.floor(Math.random()*5)];
        h.style.left = Math.random() * 100 + '%';
        h.style.animationDuration = (8 + Math.random() * 10) + 's';
        h.style.animationDelay = Math.random() * 8 + 's';
        h.style.fontSize = (14 + Math.random() * 16) + 'px';
        bg.appendChild(h);
      }
    }
    createHearts();

    // ========== MATRIX RAIN ==========
    const canvas = document.getElementById('matrixCanvas');
    const ctx = canvas.getContext('2d');
    let matrixAnim;

    function resizeMatrix() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resizeMatrix();
    window.addEventListener('resize', resizeMatrix);

    const chars = '01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン';
    const fontSize = 14;
    let columns, drops;

    function initMatrix() {
      columns = Math.floor(canvas.width / fontSize);
      drops = Array(columns).fill(1);
    }
    initMatrix();

    function drawMatrix() {
      ctx.fillStyle = 'rgba(0,0,0,0.05)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#00ff9d';
      ctx.font = fontSize + 'px monospace';
      for (let i = 0; i < drops.length; i++) {
        const text = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(text, i * fontSize, drops[i] * fontSize);
        if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }

    // ========== SCREEN MANAGEMENT ==========
    function goTo(id) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      const el = document.getElementById('screen-' + id);
      if (el) el.classList.add('active');

      if (id === 'yay') startConfetti();
      if (id === 'timer') startTimer();
      if (id === 'moments') {
        // ensure gallery is ready
        if (!galleryReady) initGallery();
      }
    }

    // ========== COUNTDOWN ==========
    async function startCountdown() {
      matrixAnim = setInterval(drawMatrix, 40);
      const num = document.getElementById('countdownNum');
      for (let i = 3; i >= 1; i--) {
        num.textContent = i;
        num.style.animation = 'none';
        void num.offsetWidth;
        num.style.animation = 'pulse 0.8s ease';
        await sleep(900);
      }
      clearInterval(matrixAnim);
      goTo('challenge');
      await sleep(1800);
      goTo('init');
      startLoading();
    }

    // ========== LOADING SEQUENCE ==========
    const loadSteps = [
      { title: 'Initializing Love.exe...', duration: 2200 },
      { title: 'Searching for the prettiest smile...', duration: 2800 },
      { title: 'Found 1 Result ❤️', duration: 1200 }
    ];

    async function startLoading() {
      const fill = document.getElementById('progressFill');
      const pct = document.getElementById('progressPct');
      const title = document.getElementById('loadTitle');
      let progress = 0;

      for (const step of loadSteps) {
        title.textContent = step.title;
        const start = progress;
        const end = step === loadSteps[2] ? 100 : progress + 40;
        const frames = 30;
        for (let i = 0; i <= frames; i++) {
          progress = start + (end - start) * (i / frames);
          fill.style.width = progress + '%';
          pct.textContent = Math.floor(progress) + '%';
          await sleep(step.duration / frames);
        }
      }
      await sleep(600);
      goTo('found');
    }

    // ========== LETTER ==========
    function openLetter() {
      document.getElementById('flap').classList.add('open');
      document.getElementById('letterLabel').textContent = 'Opening...';
      setTimeout(() => {
        goTo('msg');
        showMsg(0);
      }, 700);
    }

    // ========== MESSAGES ==========
    const messages = [
      `Hey Anushka...\nPata hai... Main ye sab normally bol nahi pata...\nLekin aaj dil ne kaha... Risk le le...\nKyuki kuch log baar baar nahi milte.`,
      `Jab bhi tum online aati ho...\nMera mood automatically better ho jata hai.`,
      `Tumhare messages...\nMere din ka favourite notification hote hain.`,
      `Honestly Anushka...\nTum meri life ki sabse pyari coincidence ho.\n\nMain tumse bahut zyada pyaar karta hoon. ❤️`
    ];
    let msgIndex = 0;

    function showMsg(i) {
      msgIndex = i;
      const text = document.getElementById('msgText');
      text.innerHTML = messages[i].replace(/\n/g, '<br>');
      const btn = document.getElementById('msgBtn');
      if (i === messages.length - 1) {
        btn.textContent = 'Continue ❤️';
      } else {
        btn.textContent = 'Next';
      }
    }

    function nextMsg() {
      if (msgIndex < messages.length - 1) {
        showMsg(msgIndex + 1);
      } else {
        goTo('coffee');
      }
    }

    // ========== NO BUTTON FUN ==========
    const noTexts = [
      'SHAYAD NAHI 🙈',
      'Nahi Na 😏',
      'Ek Baar Aur 😭',
      'Please soch lo 🥺',
      'Last chance 💔',
      'Okay fine... YES bol do 💕'
    ];
    let noClicks = 0;

    function noClick() {
      noClicks++;
      const btn = document.getElementById('noBtn');
      if (noClicks < noTexts.length) {
        btn.textContent = noTexts[noClicks];
      }
      // Move the button randomly
      const wrapper = btn.parentElement;
      const maxX = wrapper.offsetWidth - btn.offsetWidth - 10;
      const maxY = 40;
      const x = Math.random() * maxX - maxX / 2;
      const y = Math.random() * maxY - 10;
      btn.style.transform = `translate(calc(-50% + ${x}px), ${y}px)`;
    }

    // ========== CONFETTI ==========
    function startConfetti() {
      const c = document.getElementById('confetti');
      const cx = c.getContext('2d');
      c.width = window.innerWidth;
      c.height = window.innerHeight;
      const pieces = [];
      const colors = ['#ff6b9d','#ec4899','#c084fc','#60a5fa','#fbbf24','#34d399','#f472b6'];

      for (let i = 0; i < 120; i++) {
        pieces.push({
          x: Math.random() * c.width,
          y: Math.random() * c.height - c.height,
          w: 6 + Math.random() * 8,
          h: 8 + Math.random() * 10,
          color: colors[Math.floor(Math.random() * colors.length)],
          speed: 2 + Math.random() * 4,
          rot: Math.random() * 360,
          rotSpeed: -4 + Math.random() * 8
        });
      }

      function draw() {
        cx.clearRect(0, 0, c.width, c.height);
        pieces.forEach(p => {
          cx.save();
          cx.translate(p.x, p.y);
          cx.rotate((p.rot * Math.PI) / 180);
          cx.fillStyle = p.color;
          cx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          cx.restore();
          p.y += p.speed;
          p.rot += p.rotSpeed;
          if (p.y > c.height + 20) {
            p.y = -20;
            p.x = Math.random() * c.width;
          }
        });
        requestAnimationFrame(draw);
      }
      draw();
    }

    // ========== TIMER ==========
    let startTime = null;
    function startTimer() {
      if (startTime) return; // already running
      startTime = Date.now();
      setInterval(() => {
        const diff = Date.now() - startTime;
        const secs = Math.floor(diff / 1000) % 60;
        const mins = Math.floor(diff / 60000) % 60;
        const hours = Math.floor(diff / 3600000) % 24;
        const days = Math.floor(diff / 86400000);
        document.getElementById('tDays').textContent = days;
        document.getElementById('tHours').textContent = hours;
        document.getElementById('tMins').textContent = mins;
        document.getElementById('tSecs').textContent = secs;
      }, 1000);
    }

    // ========== CUTE MOMENTS GALLERY ==========
    const moments = [
      { src: '1000060430.jpg', caption: 'That soft smile 😍' },
      { src: '1000060432.jpg', caption: 'Shy cutie covering smile 🙈' },
      { src: '1000060433.jpg', caption: 'Your brightest smile ✨' },
      { src: '1000060431.jpg', caption: 'Late night talks with Princess ❤️' },
      { src: '1000060434.jpg', caption: 'More late night vibes 🌙' }
    ];

    let currentSlide = 0;
    let galleryReady = false;
    let touchStartX = 0;
    let touchEndX = 0;

    function initGallery() {
      const track = document.getElementById('galleryTrack');
      const dots = document.getElementById('galleryDots');
      track.innerHTML = '';
      dots.innerHTML = '';

      moments.forEach((m, i) => {
        const slide = document.createElement('div');
        slide.className = 'gallery-slide';
        slide.innerHTML = `
          <img src="${m.src}" alt="Cute moment ${i+1}" draggable="false">
          <div class="gallery-caption">${m.caption}</div>
        `;
        track.appendChild(slide);

        const dot = document.createElement('div');
        dot.className = 'dot' + (i === 0 ? ' active' : '');
        dot.onclick = () => goToSlide(i);
        dots.appendChild(dot);
      });

      galleryReady = true;
      updateGalleryUI();
      setupSwipe();
    }

    function openMoments() {
      if (!galleryReady) initGallery();
      currentSlide = 0;
      updateGalleryUI();
      goTo('moments');
    }

    function goToSlide(index) {
      if (index < 0 || index >= moments.length) return;
      currentSlide = index;
      updateGalleryUI();
    }

    function nextSlide() {
      if (currentSlide < moments.length - 1) {
        currentSlide++;
        updateGalleryUI();
      }
    }

    function prevSlide() {
      if (currentSlide > 0) {
        currentSlide--;
        updateGalleryUI();
      }
    }

    function updateGalleryUI() {
      const track = document.getElementById('galleryTrack');
      track.style.transform = `translateX(-${currentSlide * 100}%)`;

      document.querySelectorAll('.dot').forEach((d, i) => {
        d.classList.toggle('active', i === currentSlide);
      });

      document.getElementById('galleryCounter').textContent = `${currentSlide + 1} / ${moments.length}`;
      document.getElementById('prevBtn').disabled = currentSlide === 0;
      document.getElementById('nextBtn').disabled = currentSlide === moments.length - 1;
    }

    function setupSwipe() {
      const container = document.getElementById('galleryContainer');
      
      container.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      container.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      }, { passive: true });

      // also support mouse drag for desktop testing
      let mouseDown = false;
      container.addEventListener('mousedown', (e) => {
        mouseDown = true;
        touchStartX = e.screenX;
      });
      container.addEventListener('mouseup', (e) => {
        if (mouseDown) {
          touchEndX = e.screenX;
          handleSwipe();
        }
        mouseDown = false;
      });
      container.addEventListener('mouseleave', () => { mouseDown = false; });
    }

    function handleSwipe() {
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) nextSlide();
        else prevSlide();
      }
    }

    function sleep(ms) {
      return new Promise(r => setTimeout(r, ms));
    }

    // START
    startCountdown();
  </script>
</body>
</html>